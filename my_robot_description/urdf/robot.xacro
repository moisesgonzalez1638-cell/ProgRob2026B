<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_robot">

  <material name="blue"><color rgba="0.0 0.2 0.8 1.0"/></material>
  <material name="dark_grey"><color rgba="0.2 0.2 0.2 1.0"/></material>
  <material name="orange"><color rgba="1.0 0.5 0.0 1.0"/></material>
  <material name="red"><color rgba="0.8 0.0 0.0 1.0"/></material>
  <material name="silver"><color rgba="0.75 0.75 0.75 1.0"/></material>

  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <origin xyz="0 0 ${h/2}" rpy="0 0 0"/>
      <inertia ixx="${(1/12) * m * (3*r*r + h*h)}" ixy="0.0" ixz="0.0"
               iyy="${(1/12) * m * (3*r*r + h*h)}" iyz="0.0"
               izz="${(1/2) * m * r * r}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <origin xyz="0 0 ${z/2}" rpy="0 0 0"/>
      <inertia ixx="${(1/12) * m * (y*y + z*z)}" ixy="0.0" ixz="0.0"
               iyy="${(1/12) * m * (x*x + z*z)}" iyz="0.0"
               izz="${(1/12) * m * (x*x + y*y)}"/>
    </inertial>
  </xacro:macro>

  <link name="world"/>

  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Base del Manipulador -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><cylinder radius="0.16" length="0.1"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><cylinder radius="0.16" length="0.1"/></geometry>
    </collision>
    <xacro:cylinder_inertia m="5.0" r="0.16" h="0.1"/>
  </link>

  <!-- Articulación 1: Cintura (Yaw) -->
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="50.0" velocity="2.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <link name="link_1">
    <visual>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry><cylinder radius="0.07" length="0.3"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry><cylinder radius="0.07" length="0.3"/></geometry>
    </collision>
    <xacro:cylinder_inertia m="2.0" r="0.07" h="0.3"/>
  </link>

  <!-- Articulación 2: Hombro (Pitch) -->
  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 0.3" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="50.0" velocity="2.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <link name="link_2">
    <visual>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <geometry><box size="0.07 0.07 0.4"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.2" rpy="0 0 0"/>
      <geometry><box size="0.07 0.07 0.4"/></geometry>
    </collision>
    <xacro:box_inertia m="1.5" x="0.07" y="0.07" z="0.4"/>
  </link>

  <!-- Articulación 3: Codo (Pitch) -->
  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0 0 0.4" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="2.5" effort="40.0" velocity="2.0"/>
    <dynamics damping="0.4" friction="0.1"/>
  </joint>

  <link name="link_3">
    <visual>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry><box size="0.055 0.055 0.3"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry><box size="0.055 0.055 0.3"/></geometry>
    </collision>
    <xacro:box_inertia m="1.0" x="0.055" y="0.055" z="0.3"/>
  </link>

  <!-- Articulación 4: Muñeca (Roll) -->
  <joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="0 0 0.3" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="20.0" velocity="2.5"/>
    <dynamics damping="0.2" friction="0.05"/>
  </joint>

  <link name="link_4">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.1"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.1"/></geometry>
    </collision>
    <xacro:cylinder_inertia m="0.4" r="0.035" h="0.1"/>
  </link>

  <!-- Efector Final (Gripper visual con dos dedos) -->
  <joint name="joint_gripper_base" type="fixed">
    <parent link="link_4"/>
    <child link="gripper_base"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
  </joint>

  <link name="gripper_base">
    <visual>
      <origin xyz="0 0 0.015" rpy="0 0 0"/>
      <geometry><box size="0.04 0.10 0.03"/></geometry>
      <material name="red"/>
    </visual>
    <visual>
      <origin xyz="0 0.04 0.045" rpy="0 0 0"/>
      <geometry><box size="0.02 0.015 0.04"/></geometry>
      <material name="silver"/>
    </visual>
    <visual>
      <origin xyz="0 -0.04 0.045" rpy="0 0 0"/>
      <geometry><box size="0.02 0.015 0.04"/></geometry>
      <material name="silver"/>
    </visual>
    <xacro:box_inertia m="0.2" x="0.04" y="0.10" z="0.05"/>
  </link>

  <!-- Sensor de Visión Virtual (Eye-to-Hand cenital sobre la zona de entrada) -->
  <joint name="camera_joint" type="fixed">
    <parent link="world"/>
    <child link="camera_link"/>
    <origin xyz="0.40 0.0 0.40" rpy="0 1.5707963 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <geometry><box size="0.04 0.08 0.04"/></geometry>
      <material name="dark_grey"/>
    </visual>
    <xacro:box_inertia m="0.1" x="0.04" y="0.08" z="0.04"/>
  </link>

  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
  </joint>

  <link name="camera_optical_frame"/>

  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <always_on>1</always_on>
      <update_rate>15</update_rate>
      <visualize>true</visualize>
      <topic>camera/image_raw</topic>
      <camera>
        <horizontal_fov>1.45</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>5.0</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <!-- Interfaz Hardware ros2_control -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="joint_1">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_2">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">-0.4</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_3">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.8</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_4">
      <command_interface name="position"/>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- Plugin gz_ros2_control -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find my_robot_description)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- Plugins DetachableJoint para agarre determinista de los 4 objetos -->
  <xacro:macro name="detachable_obj" params="obj_name">
    <gazebo>
      <plugin filename="gz-sim-detachable-joint-system" name="gz::sim::systems::DetachableJoint">
        <parent_link>link_4</parent_link>
        <child_model>${obj_name}</child_model>
        <child_link>link</child_link>
        <detach_topic>/gripper/detach/${obj_name}</detach_topic>
        <attach_topic>/gripper/attach/${obj_name}</attach_topic>
        <output_topic>/gripper/state/${obj_name}</output_topic>
      </plugin>
    </gazebo>
  </xacro:macro>

  <xacro:detachable_obj obj_name="obj_red_1"/>
  <xacro:detachable_obj obj_name="obj_green_1"/>
  <xacro:detachable_obj obj_name="obj_blue_1"/>
  <xacro:detachable_obj obj_name="obj_red_2"/>

</robot>
