<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="workcell">
    <physics name="1ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <!-- Piso -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>10 10</size></plane></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Mesa de trabajo (superficie superior en z = 0.50 m) -->
    <model name="work_table">
      <static>true</static>
      <pose>0.15 0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.3 1.3 0.5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.3 1.3 0.5</size></box></geometry>
          <material><ambient>0.85 0.82 0.75 1</ambient><diffuse>0.85 0.82 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ZONA DE SALIDA: 3 Bandejas de Clasificación -->
    <!-- Bandeja Roja -->
    <model name="bin_red">
      <static>true</static>
      <pose>0.15 -0.40 0.505 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.16 0.16 0.01</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.9 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Bandeja Verde -->
    <model name="bin_green">
      <static>true</static>
      <pose>0.15 0.40 0.505 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.16 0.16 0.01</size></box></geometry>
          <material><ambient>0.1 0.7 0.1 1</ambient><diffuse>0.1 0.8 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Bandeja Azul -->
    <model name="bin_blue">
      <static>true</static>
      <pose>-0.25 0.35 0.505 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.16 0.16 0.01</size></box></geometry>
          <material><ambient>0.1 0.2 0.8 1</ambient><diffuse>0.1 0.2 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ZONA DE ENTRADA: 4 Objetos Cilíndricos (radio=0.025, alto=0.06) -->
    <model name="obj_red_1">
      <pose>0.31 -0.15 0.53 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.000015</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.025</radius><length>0.06</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.025</radius><length>0.06</length></cylinder></geometry>
          <material><ambient>0.9 0.05 0.05 1</ambient><diffuse>0.95 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obj_green_1">
      <pose>0.47 -0.13 0.53 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.000015</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.025</radius><length>0.06</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.025</radius><length>0.06</length></cylinder></geometry>
          <material><ambient>0.05 0.85 0.05 1</ambient><diffuse>0.05 0.9 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obj_blue_1">
      <pose>0.31 0.15 0.53 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.000015</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.025</radius><length>0.06</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.025</radius><length>0.06</length></cylinder></geometry>
          <material><ambient>0.05 0.15 0.9 1</ambient><diffuse>0.05 0.2 0.95 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obj_red_2">
      <pose>0.47 0.13 0.53 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.000015</izz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><cylinder><radius>0.025</radius><length>0.06</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.025</radius><length>0.06</length></cylinder></geometry>
          <material><ambient>0.9 0.05 0.05 1</ambient><diffuse>0.95 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <light type="point" name="table_fill_light">
      <pose>0.40 0.0 1.4 0 0 0</pose>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>5.0</range><constant>0.5</constant><linear>0.01</linear></attenuation>
    </light>
  </world>
</sdf>
